# Opcional: copie para .env; o servidor lê somente estas opções.
FAROL_HOST=127.0.0.1
FAROL_PORT=8000
FAROL_DB=data/farol.sqlite3
# Gere uma senha sintética com pelo menos 12 caracteres OU deixe em branco:
# o seed imprime uma senha aleatória uma única vez. Nunca use senha real.
FAROL_DEMO_PASSWORD=
# Ative somente quando servido via HTTPS. Loopback local usa HTTP.
FAROL_SECURE_COOKIE=false
# Reavaliação periódica enquanto o servidor local está em execução.
FAROL_EVALUATION_INTERVAL=60
